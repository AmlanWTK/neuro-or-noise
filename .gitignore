# --- data: never commit EEG recordings ---
# The HUSM dataset is redistributable only under its own figshare terms.
# Keep it out of git entirely; point the code at it with --data.
data/
*.edf
*.bdf
*.set
*.fdt
*.mat

# --- experiment outputs ---
# Loose files at the top of results/ are scratch -- ignore them.
results/*.json
results/*.csv
results/*.png
results/*.pdf
!results/.gitkeep

# BUT results/runs/ is the experimental record and IS committed. Each run dir
# holds meta.json (command + git commit + versions), console.log and
# result.json -- a few KB, and the only way to trace a number in the paper back
# to the code that produced it.
!results/runs/
!results/runs/**

# model weights are large and regenerable
checkpoints/
*.pt
*.pth

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# --- editors / os ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
